class Solution(object):
    def arraySign(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """

        # second approach

        if 0 in nums:
            return 0

        prod = 1
        for num in nums:
            if num < 0:
                prod *= -1

        def signFunc(x):
            if x>0:
                return 1
            else:
                return -1
        return signFunc(prod)      
        
