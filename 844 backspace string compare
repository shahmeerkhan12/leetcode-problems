class Solution(object):
    def backspaceCompare(self, s, t):
        """
        :type s: str
        :type t: str
        :rtype: bool
        """

        def build_string(s):
            res = []
            for i in s:
                if i=="#":
                    if res:
                        res.pop()
                else:
                    res.append(i)

            return res

        if build_string(s) == build_string(t):     
            return True
        else:
            return False
